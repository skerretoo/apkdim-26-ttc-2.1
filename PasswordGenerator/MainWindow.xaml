<Window x:Class="PasswordGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="PassForge — Password Generator"
        Width="580" Height="820" MinWidth="480" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <materialDesign:DialogHost>
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel MaxWidth="540" Orientation="Vertical">

                <!-- Header -->
                <Grid Margin="0,4,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:Card Grid.Column="0" Padding="10" Margin="0,0,12,0"
                                         Background="{DynamicResource PrimaryHueMidBrush}">
                        <materialDesign:PackIcon Kind="ShieldLock" Width="28" Height="28" Foreground="White" />
                    </materialDesign:Card>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PassForge" Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}" FontWeight="Bold" />
                        <TextBlock Text="Advanced password generator" Style="{StaticResource MaterialDesignBodyMediumTextBlock}" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="WeatherNight" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      IsChecked="{Binding IsDarkTheme}"
                                      ToolTip="Dark / light theme" />
                    </StackPanel>
                </Grid>

                <!-- Current password -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource MaterialDesignLabelSmallTextBlock}" Opacity="0.6" Margin="0,0,0,8" />
                        <TextBox Text="{Binding CurrentPassword, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Cascadia Code, Consolas, monospace"
                                 FontSize="17"
                                 TextWrapping="Wrap"
                                 MinHeight="64"
                                 materialDesign:TextFieldAssist.HasClearButton="False"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 VerticalContentAlignment="Center" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="GENERATE"
                                    Command="{Binding GenerateCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="12"
                                    Height="40" Margin="0,0,8,0" />
                            <Button Grid.Column="1" ToolTip="Copy"
                                    Command="{Binding CopyCurrentCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="40" Height="40" Margin="0,0,4,0">
                                <materialDesign:PackIcon Kind="ContentCopy" />
                            </Button>
                            <Button Grid.Column="2" ToolTip="Regenerate"
                                    Command="{Binding GenerateCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="40" Height="40">
                                <materialDesign:PackIcon Kind="Refresh" />
                            </Button>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StrengthText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Opacity="0.7" VerticalAlignment="Center">
                                <Run Text="{Binding EntropyBits, StringFormat={}{0:F1}}" /><Run Text=" bits entropy" />
                            </TextBlock>
                        </Grid>
                        <ProgressBar Value="{Binding StrengthPercent}" Maximum="100" Height="8" Margin="0,8,0,0"
                                     Style="{StaticResource MaterialDesignLinearProgressBar}" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- Settings -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource MaterialDesignLabelSmallTextBlock}" Opacity="0.6" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Length" Style="{StaticResource MaterialDesignBodyLargeTextBlock}" VerticalAlignment="Center" />
                            <materialDesign:Chip Grid.Column="1" Content="{Binding LengthText}" />
                        </Grid>
                        <Slider Minimum="4" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Length, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,8" />
                        <TextBlock Text="4 – 64 characters. 14+ recommended." Opacity="0.55"
                                   Style="{StaticResource MaterialDesignBodySmallTextBlock}" Margin="0,0,0,12" />

                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <ToggleButton IsChecked="{Binding IncludeUpper}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Margin="0,0,10,0" />
                                <TextBlock Text="Uppercase (A–Z)" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <ToggleButton IsChecked="{Binding IncludeLower}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Margin="0,0,10,0" />
                                <TextBlock Text="Lowercase (a–z)" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <ToggleButton IsChecked="{Binding IncludeDigits}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Margin="0,0,10,0" />
                                <TextBlock Text="Numbers (0–9)" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <ToggleButton IsChecked="{Binding IncludeSymbols}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Margin="0,0,10,0" />
                                <TextBlock Text="Symbols (!@#…)" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>

                        <CheckBox IsChecked="{Binding EnsureEachCategory}" Margin="0,6,0,0"
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  Content="Guarantee each selected set appears at least once" />
                        <CheckBox IsChecked="{Binding ExcludeAmbiguous}" Margin="0,6,0,0"
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  Content="Exclude ambiguous (Il1O0 …)" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- Last 3 — RAM only -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LAST 3 — MEMORY ONLY" Style="{StaticResource MaterialDesignLabelSmallTextBlock}" Opacity="0.6" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="CLEAR" FontSize="11"
                                    Command="{Binding ClearHistoryCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" />
                        </Grid>

                        <TextBlock Text="Generate a password to see it here." Opacity="0.55" Margin="0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBodyMediumTextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding History.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,4" Padding="12,8" Background="{DynamicResource MaterialDesignCardBackground}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Value}" FontFamily="Cascadia Code, Consolas, monospace"
                                                       FontSize="13" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" ToolTip="{Binding Value}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ShortTime}" Opacity="0.5"
                                                       FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                                            <Button Grid.Column="2"
                                                    Command="{Binding DataContext.CopyFromHistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="32" Height="32" ToolTip="Copy this password">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" />
                                            </Button>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="LockOff" Width="16" Height="16" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="Kept in RAM only — never saved to disk, registry, or cloud."
                                       Opacity="0.6" FontSize="11" Margin="6,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <TextBlock Text="{Binding StatusMessage}" Opacity="0.6" TextWrapping="Wrap"
                           Style="{StaticResource MaterialDesignBodySmallTextBlock}" Margin="4,0,4,16" />
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Snackbar MessageQueue="{Binding SnackbarQueue}"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
      </Grid>
    </materialDesign:DialogHost>
</Window>
