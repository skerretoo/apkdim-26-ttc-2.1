<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Native Windows-only desktop (WPF on DirectX, no Electron/Chromium/WebView) -->
    <!-- 10.0.26100.0 = Windows 11 24H2 SDK: rounded corners, Mica-ready, newest APIs -->
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PasswordGenerator</RootNamespace>
    <AssemblyName>PassForge</AssemblyName>
    <Product>PassForge — Advanced Password Generator</Product>
    <Version>1.0.0</Version>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Single-file, trimmed, AOT-incompatible (WPF) but self-contained-ready -->
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Newest stable as of Sep 2026 -->
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
